{
  "name": "fixseo",
  "version": "0.2.0",
  "description": "SEO analysis CLI and OpenCode tool - scan websites for SEO issues",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tool": "./src/tool.ts"
  },
  "bin": {
    "fixseo": "bin/main"
  },
