    "fast-xml-parser": "^5.3.7",
    "linkedom": "^0.18.12",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  }
