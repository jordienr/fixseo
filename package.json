{
  "name": "fixseo",
  "version": "0.8.2",
  "description": "SEO analysis CLI and OpenCode tool - scan websites for SEO issues",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tool": "./src/tool.ts"
  },
  "bin": {
    "fixseo": "bin/main"
  },
  "scripts": {
    "cli": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node",
    "dev": "cd web && npm run dev",
    "dev:serve": "bun run web/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "pub": "npm run build && npm test && npm publish --access public",
    "bump:patch": "npm version patch",
    "bump:minor": "npm version minor",
    "bump:major": "npm version major"
  },
  "keywords": [
    "seo",
    "cli",
    "analysis",
    "crawler",
    "opencode"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.10",
    "@types/bun": "^1.3.9",
    "fast-xml-parser": "^5.3.7",
    "linkedom": "^0.18.12",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  }
}
